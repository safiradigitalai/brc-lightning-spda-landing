# Supabase Configuration
# Obtenha essas informações no painel do Supabase (https://supabase.com)

# Variáveis para servidor (API routes) - usadas em /lib/database.ts
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Variáveis para cliente (browser) - opcional se usando apenas API routes
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url  
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin Authentication (para modo estático)
NEXT_PUBLIC_ADMIN_EMAIL=admin@brc-spda.com
NEXT_PUBLIC_ADMIN_PASSWORD=brc2024admin

# Kommo CRM Integration
KOMMO_SECRET_KEY=your_kommo_secret_key
KOMMO_ACCESS_TOKEN=your_kommo_long_lived_token
KOMMO_INTEGRATION_ID=your_kommo_integration_id
KOMMO_SUBDOMAIN=your_kommo_subdomain
KOMMO_PIPELINE_ID=12051759
KOMMO_STATUS_ID=92986715
KOMMO_RESPONSIBLE_USER_ID=10422107